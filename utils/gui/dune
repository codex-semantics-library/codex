(rule
 (with-stdout-to
     binsec_webapp_string.ml
   (progn
     (echo "let binsec_webapp_dot_bc_dot_js = {codexembed|")
     (cat js/binsec_webapp.bc.js)
     (echo "|codexembed}"))))

