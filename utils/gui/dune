(library 
  (name interface)
  (public_name codex.gui.interface)
  (libraries codex.syntax_tree codex.binarytrace)
  (modules interface))


(library 
  (name gui)
  (public_name codex.gui)
  (libraries codex.file_to_html unix base64 (re_export codex.gui.interface)
  	     codex.syntax_tree)
  (modules :standard \ interface))

(documentation
  (package codex))
